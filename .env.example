# Copy to .env.local and fill in. Never commit real values.

# Public base URL for canonical links and link previews (https://a3ra.in once live).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string. Server-only — never prefix with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# a3ra_dev locally, a3ra in production.
MONGODB_DB=a3ra_dev

# Gmail SMTP: the sending account and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Leave GMAIL_APP_PASSWORD empty to save leads without sending email.
GMAIL_USER=a3ra.official@gmail.com
GMAIL_APP_PASSWORD=
# Comma-separated addresses that receive new-lead notifications.
LEAD_NOTIFICATION_RECIPIENTS=a3ra.official@gmail.com

# Random secret for hashing IPs (rate limiting). Generate: openssl rand -hex 24
RATE_LIMIT_SALT=
